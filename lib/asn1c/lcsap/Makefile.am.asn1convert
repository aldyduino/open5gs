include Makefile.am.libasncodec

bin_PROGRAMS += asn1convert
asn1convert_CFLAGS = $(ASN_MODULE_CFLAGS) -DASN_DISABLE_BER_SUPPORT -DASN_DISABLE_XER_SUPPORT -DASN_DISABLE_OER_SUPPORT -DASN_DISABLE_UPER_SUPPORT -DASN_DISABLE_JER_SUPPORT -DASN_DISABLE_CBOR_SUPPORT 
asn1convert_CPPFLAGS = -I$(top_srcdir)/-DASN_PDU_COLLECTION 
asn1convert_LDADD = libasncodec.la
asn1convert_SOURCES = \
	converter-example.c\
	pdu_collection.c
regen: regenerate-from-asn1-source

regenerate-from-asn1-source:
	asn1c -pdu=all -fprefix=LCSAP_ -fcompound-names -findirect-choice -fno-include-deps -no-gen-BER -no-gen-XER -no-gen-JER -no-gen-CBOR -no-gen-OER -no-gen-UPER ../support/lcsap-r17/LCS-AP-CommonDataTypes.asn ../support/lcsap-r17/LCS-AP-Constants.asn ../support/lcsap-r17/LCS-AP-Containers.asn ../support/lcsap-r17/LCS-AP-IEs.asn ../support/lcsap-r17/LCS-AP-PDU-Contents.asn ../support/lcsap-r17/LCS-AP-PDU-Descriptions.asn

